# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit .env itself (see .gitignore).
# See docs/INTAKE.md §4 "Secrets management" and docs/USER_MANUAL.md.

# --- Networking (docs/INTAKE.md §2) ---
# The address WebRTC browsers use in SDP/ICE to reach FreeSWITCH's media and
# signaling. On macOS/Docker Desktop this MUST be your Mac's LAN IP (not
# 127.0.0.1, not the container's internal docker IP) for anything beyond a
# same-container test -- see docs/DEBUGGING.md "no audio".
# Find it with: ipconfig getifaddr en0   (or en1, depending on your adapter)
EXTERNAL_RTP_IP=127.0.0.1
EXTERNAL_SIP_IP=127.0.0.1

# Domain FreeSWITCH registers SIP users under (sip:1000@LAB_DOMAIN). Can stay
# as-is for local dev; set to a real reachable hostname for a demo deployment.
LAB_DOMAIN=fs.local

# --- Per-extension SIP passwords (native auth, no hosted token -- see
#     docs/INTAKE.md §1/§4). CHANGE THESE before exposing beyond localhost. ---
EXT_1000_PASSWORD=changeme1000
EXT_1001_PASSWORD=changeme1001
EXT_1002_PASSWORD=changeme1002
EXT_1003_PASSWORD=changeme1003

# --- ESL (Event Socket) password -- never published to the host, but should
#     still not stay on FreeSWITCH's well-known default. ---
ESL_PASSWORD=ClueCon

# --- pstn-sim (simulated PSTN, docs/INTAKE.md §7) ---
PSTN_SIM_DOMAIN=pstn-sim.local
EXT_2000_PASSWORD=changeme2000

# --- coturn (STUN/TURN, docs/INTAKE.md §2/§7 -- required for WebRTC behind
#     real NAT, not just a lab nicety) ---
TURN_USER=labuser
TURN_PASSWORD=changeme_turn
# Must match EXTERNAL_RTP_IP for coturn's relay to be reachable by browsers.
TURN_EXTERNAL_IP=127.0.0.1
