<profile name="internal">
  <!-- SIP registration + WebRTC (WS/WSS). See docs/INTAKE.md §2/§3. -->
  <aliases/>
  <gateways/>

  <domains>
    <domain name="all" alias="true" parse="false"/>
  </domains>

  <settings>
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>
    <param name="context" value="public"/>
    <param name="rfc2833-pt" value="101"/>
    <param name="sip-port" value="$${internal_sip_port}"/>
    <param name="dialplan" value="XML"/>
    <param name="dtmf-duration" value="2000"/>
    <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
    <param name="outbound-codec-prefs" value="$${global_codec_prefs}"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <!-- Without this, FreeSWITCH filters incoming WebRTC ICE candidates
         against "wan.auto" by default, which DENIES private/RFC1918
         addresses by design (see conf/autoload_configs/acl.conf.xml's
         auto-generated lists). Every candidate a browser on a home/office
         LAN offers (host candidates, and often even the STUN-reflexive one
         behind carrier-grade NAT) is a private address, so with only
         wan.auto every candidate gets dropped and the call fails with
         INCOMPATIBLE_DESTINATION right after answer - see
         docs/DEBUGGING.md. Deliberately rfc1918.auto, not localnet.auto:
         localnet.auto only covers *this container's own* detected subnet
         (the docker bridge, 172.x), not the browser's real LAN - rfc1918.auto
         allows all private ranges outright, which is the correct trust
         model for a same-LAN lab (would need narrowing for a real
         multi-tenant/public deployment). Multiple params are additive. -->
    <param name="apply-candidate-acl" value="rfc1918.auto"/>
    <param name="apply-candidate-acl" value="wan.auto"/>
    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="hold-music" value="$${hold_music}"/>
    <param name="apply-nat-acl" value="nat.auto"/>
    <param name="apply-inbound-acl" value="domains"/>
    <param name="local-network-acl" value="localnet.auto"/>
    <param name="inbound-late-negotiation" value="true"/>
    <param name="nonce-ttl" value="60"/>
    <param name="auth-calls" value="$${internal_auth_calls}"/>
    <param name="auth-subscriptions" value="true"/>
    <param name="inbound-reg-force-matching-username" value="true"/>
    <param name="auth-all-packets" value="false"/>
    <param name="challenge-realm" value="auto_from"/>
    <param name="manage-presence" value="false"/>

    <!-- TLS (SIPS on 5061). Disabled by default - see docs/INTAKE.md §7 re:
         cert strategy (self-signed dev vs Let's Encrypt demo). WSS below is
         what WebRTC browsers actually use. -->
    <param name="tls" value="$${internal_ssl_enable}"/>
    <param name="tls-only" value="false"/>
    <param name="tls-bind-params" value="transport=tls"/>
    <param name="tls-sip-port" value="$${internal_tls_port}"/>
    <!-- Literal path, not $${certs_dir} - FreeSWITCH's autotools install
         layout computes that as .../etc/freeswitch/tls (a directory this
         image doesn't even ship, see Dockerfile), not our mounted conf/tls.
         entrypoint.sh generates a self-signed wss.pem here on first start
         if one isn't already present (see docs/INTAKE.md §2/§7). -->
    <param name="tls-cert-dir" value="/usr/local/freeswitch/conf/tls"/>
    <param name="tls-passphrase" value=""/>
    <param name="tls-verify-date" value="true"/>
    <param name="tls-verify-policy" value="none"/>
    <param name="tls-verify-depth" value="2"/>
    <param name="tls-version" value="$${sip_tls_version}"/>
    <param name="tls-ciphers" value="$${sip_tls_ciphers}"/>

    <!-- ext-rtp-ip / ext-sip-ip: the address advertised to WebRTC browser
         clients in SDP/ICE. See vars.xml + docs/INTAKE.md §2 - this is the
         #1 cause of "call connects, no audio". -->
    <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>
    <param name="ext-sip-ip" value="$${external_sip_ip}"/>
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>

    <param name="force-register-domain" value="$${domain}"/>
    <param name="force-subscription-domain" value="$${domain}"/>
    <param name="force-register-db-domain" value="$${domain}"/>

    <!-- SIP over plain WebSocket -->
    <param name="ws-binding" value=":5066"/>
    <!-- SIP over secure WebSocket (WSS) - what the browser webapp uses.
         FreeSWITCH auto-generates conf/tls/wss.pem (self-signed) if missing. -->
    <param name="wss-binding" value=":7443"/>
  </settings>
</profile>
